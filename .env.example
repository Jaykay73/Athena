# ==============================================================================
# ATHENA CONFIGURATION TEMPLATE
# ==============================================================================

# Model Provider Selection:
# Options: 'openai' | 'gemini' | 'deepseek' | 'openrouter' | 'deterministic'
# Note: If no key is set, Athena uses its offline deterministic engine.
ATHENA_MODEL_PROVIDER=openai
ATHENA_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# API KEYS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# DATABASE & STORAGE
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///storage/athena.db

# ------------------------------------------------------------------------------
# EXECUTION GUARDRAILS
# ------------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS_PER_ANALYSIS=15
EXECUTION_TIMEOUT_SECONDS=30
